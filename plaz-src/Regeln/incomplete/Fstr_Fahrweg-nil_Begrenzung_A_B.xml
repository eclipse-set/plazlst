<?xml version="1.0" encoding="UTF-8"?>
<iso:rule xmlns:iso="http://purl.oclc.org/dsdl/schematron"  xmlns:planpro="http://www.plan-pro.org/regeln/struktur"
    role="$Role" flag="incomplete" planpro:bezug="relevante Begrenzung_A oder Begrenzung_B (in Fstr_Fahrweg.Bereich_Objekt_Teilbereich) nil"
    context="Fstr_Fahrweg
    [../(parent::LST_Zustand_Ziel | parent::LST_Zustand)]
    [fx:detect-nil(Bereich_Objekt_Teilbereich
       [ID_TOP_Kante/Wert = key('Signal', current()/$Signal-Referenz/Wert, /*)[1]
          /Punkt_Objekt_TOP_Kante[Wirkrichtung/Wert = $Wirkrichtung]/ID_TOP_Kante/Wert]
       /(Begrenzung_A | Begrenzung_B))]">
    <iso:assert  diagnostics="guid typ bereich"
        test="false()"/>
</iso:rule>