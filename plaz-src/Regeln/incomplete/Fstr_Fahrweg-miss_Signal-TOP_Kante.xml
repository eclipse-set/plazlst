<?xml version="1.0" encoding="UTF-8"?>
<iso:rule xmlns:iso="http://purl.oclc.org/dsdl/schematron"  xmlns:planpro="http://www.plan-pro.org/regeln/struktur"
    role="$Role" flag="incomplete" planpro:bezug="fehlende referenzierte TOP_Kante"
    context="Fstr_Fahrweg
    [../(parent::LST_Zustand_Ziel | parent::LST_Zustand)]
    [key('Signal', $Signal-Referenz/Wert, /*)
    [Punkt_Objekt_TOP_Kante[ID_TOP_Kante/Wert = current()/Bereich_Objekt_Teilbereich/ID_TOP_Kante/Wert]
       [Wirkrichtung/Wert = $Wirkrichtung]]]
    [not(key('TOP_Kante',
      key('Signal', current()/$Signal-Referenz/Wert, /*)[1]/Punkt_Objekt_TOP_Kante
       [Wirkrichtung/Wert = $Wirkrichtung]/ID_TOP_Kante/Wert
          [. = current()/Bereich_Objekt_Teilbereich/ID_TOP_Kante/Wert], /*))]">
    <iso:assert  diagnostics="guid typ bereich"
        test="false()"/>
</iso:rule>