<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.eclipse.set</groupId>
	<artifactId>org.eclipse.set.feature.plaz.schema</artifactId>
	<version>2.8.0-SNAPSHOT</version>
	<packaging>eclipse-plugin</packaging>

	<parent>
		<relativePath>../</relativePath>
		<groupId>org.eclipse.set</groupId>
		<artifactId>org.eclipse.set.feature.releng.plaz.parent</artifactId>
		<version>2.8.0-SNAPSHOT</version>
	</parent>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>xml-maven-plugin</artifactId>
				<version>1.0</version>
				<executions>
					<execution>
						<id>concat</id>
						<goals>
							<goal>transform</goal>
						</goals>
						<configuration>
							<transformationSets>
								<transformationSet>
									<includes>Regeln/Regelbasis.sch</includes>
									<dir>../plaz-src</dir>
									<stylesheet>../plaz-src/Schematron/iso_dsdl_include.xsl</stylesheet>
									<outputDir>res-tmp/</outputDir>
									<fileMappers>
										<fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
											<pattern>.*</pattern>
											<replacement>Regelbasis_included.sch</replacement>
										</fileMapper>
									</fileMappers>
								</transformationSet>
								<transformationSet>
									<includes>Regelbasis_included.sch</includes>
									<dir>res-tmp</dir>
									<stylesheet>../plaz-src/Schematron/iso_abstract_expand.xsl</stylesheet>
									<outputDir>res-tmp/</outputDir>
									<fileMappers>
										<fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
											<pattern>.*</pattern>
											<replacement>Regelbasis_expanded.sch</replacement>
										</fileMapper>
									</fileMappers>
								</transformationSet>
								<transformationSet>
									<includes>Regelbasis_expanded.sch</includes>
									<dir>res-tmp</dir>
									<stylesheet>../plaz-src/Schematron/iso_svrl_for_xslt2.xsl</stylesheet>
									<outputDir>res/</outputDir>
									<parameters>
										<parameter>
											<name>allow-foreign</name>
											<value>true</value>
										</parameter>
									</parameters>
									<fileMappers>
										<fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
											<pattern>.*</pattern>
											<replacement>Regelbasis_compiled.sch</replacement>
										</fileMapper>
									</fileMappers>
								</transformationSet>
							</transformationSets>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>net.sf.saxon</groupId>
						<artifactId>Saxon-HE</artifactId>
						<version>12.4</version>
						<type>jar</type>
					</dependency>
					<dependency>
						<groupId>org.xmlresolver</groupId>
						<artifactId>xmlresolver</artifactId>
						<version>6.0.4</version>
						<type>jar</type>
					</dependency>
				</dependencies>
			</plugin>
			<!-- Copy resources -->
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<id>copy-files-pictures</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>res/Pictures</outputDirectory>
							<resources>
								<resource>
									<directory>../plaz-src/Pictures</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-files</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>res</outputDirectory>
							<resources>
								<resource>
									<directory>../plaz-src/XSLs</directory>
									<include>GroupedSVRL.xsl</include>
									<include>HierarchicalSVRL.xsl</include>
									<include>svrl2any-base.xsl</include>
									<include>svrl2html.xsl</include>
									<include>svrl2xslfo.xsl</include>
									<include>svrl2gsvrl.xsl</include>
									<include>gsvrl2html.xsl</include>
									<include>gsvrl2xslfo.xsl</include>
									<include>AP-Objektzuordnung.xml</include>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>